# Generate a unique value for deployments: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace-with-a-random-secret
# Generate a different unique value for deployments using the same command.
JWT_SECRET=replace-with-a-different-random-secret
COOKIE_SECURE=false

# Optional: set both values to enable Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI configured in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
